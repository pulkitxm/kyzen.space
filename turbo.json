{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "WEB_URL",
    "PORT",
    "HOST",
    "REDIS_URL",
    "PUBLIC_REALTIME_URL",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SOCKET_URL",
    "KLIPY_API_KEY",
    "GENDERIZE_API_KEY",
    "NOT_ALLOWED_USERNAMES",
    "USERNAME_CHANGE_COOLDOWN_DAYS",
    "PRESENCE_HEARTBEAT_MS",
    "PRESENCE_STALE_MS",
    "PRESENCE_LASTSEEN_PERSIST_MS"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "type-check": {},
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
