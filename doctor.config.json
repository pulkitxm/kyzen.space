{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "overrides": [
      {
        "files": ["app/layout.tsx"],
        "rules": [
          "react-doctor/no-danger",
          "react-doctor/nextjs-no-native-script"
        ]
      },
      {
        "files": ["lib/socket/socket-context.tsx"],
        "rules": [
          "react-doctor/no-adjust-state-on-prop-change",
          "react-doctor/only-export-components",
          "react-doctor/no-cascading-set-state"
        ]
      },
      {
        "files": ["components/ui/page.tsx"],
        "rules": [
          "react-doctor/nextjs-missing-metadata",
          "react-doctor/no-multi-comp"
        ]
      },
      {
        "files": ["lib/appearance.tsx"],
        "rules": [
          "react-doctor/no-derived-state",
          "react-doctor/no-event-handler"
        ]
      },
      {
        "files": ["components/ui/character.tsx", "src/ui/character.tsx"],
        "rules": ["react-doctor/nextjs-no-img-element"]
      },
      {
        "files": ["components/ui/profile-popup.tsx"],
        "rules": [
          "react-doctor/no-initialize-state",
          "react-doctor/no-derived-state",
          "react-doctor/prefer-tag-over-role"
        ]
      },
      {
        "files": ["components/ui/layered-popup.tsx"],
        "rules": [
          "react-doctor/no-initialize-state",
          "react-doctor/no-render-in-render"
        ]
      },
      {
        "files": ["app/play/[gameId]/game-chat-split.tsx"],
        "rules": [
          "react-doctor/prefer-useReducer",
          "react-doctor/rerender-state-only-in-handlers",
          "react-doctor/no-derived-useState",
          "react-doctor/no-derived-state",
          "react-doctor/no-initialize-state",
          "react-doctor/no-cascading-set-state",
          "react-doctor/no-event-handler",
          "react-doctor/exhaustive-deps"
        ]
      },
      {
        "files": ["app/[username]/avatar-editor.tsx"],
        "rules": [
          "react-doctor/no-derived-useState",
          "react-doctor/no-giant-component",
          "react-doctor/prefer-useReducer",
          "react-doctor/prefer-html-dialog",
          "react-doctor/prefer-tag-over-role"
        ]
      },
      {
        "files": ["app/settings/account-identity-form.tsx"],
        "rules": [
          "react-doctor/prefer-useReducer",
          "react-doctor/no-derived-useState",
          "react-doctor/async-defer-await",
          "react-doctor/prefer-html-dialog"
        ]
      },
      {
        "files": ["app/chat/[handle]/composer-picker.tsx"],
        "rules": ["react-doctor/prefer-useReducer"]
      },
      {
        "files": ["app/sidebar.tsx"],
        "rules": ["react-doctor/no-giant-component"]
      },
      {
        "files": ["src/playing-cards/playing-card.tsx"],
        "rules": ["react-doctor/no-danger", "react-doctor/no-multi-comp"]
      },
      {
        "files": ["src/games/tic-tac-toe/client.tsx"],
        "rules": [
          "react-doctor/js-tosorted-immutable",
          "react-doctor/no-giant-component",
          "react-doctor/prefer-useReducer",
          "react-doctor/rerender-state-only-in-handlers",
          "react-doctor/no-cascading-set-state",
          "react-doctor/no-event-handler"
        ]
      }
    ]
  }
}
