# ─────────────────────────────────────────────────────────────
# GameLobby — single root .env consumed by every app.
# Copy to `.env` and fill in. Loaded via `bun --env-file=.env`.
# (apps/web/.env is a committed symlink → this file's sibling .env)
# ─────────────────────────────────────────────────────────────

# Postgres connection string (see scripts/docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gamelobby

# ── Backend: apps/server (Express + Better Auth + Socket.IO) ──
PORT=4000
# Public origin of the backend. Better Auth signs callbacks against this.
BETTER_AUTH_URL=http://localhost:4000
# Session signing key — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_with_32_byte_base64_secret
# Frontend origin (CORS + Better Auth trustedOrigins)
WEB_URL=http://localhost:3000

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis (optional). Set to enable the Socket.IO redis-adapter for multi-instance
# scale-out. Leave unset for single-node dev.
# REDIS_URL=redis://localhost:6379

# Public realtime origin advertised by matchmaking (defaults to BETTER_AUTH_URL)
# PUBLIC_REALTIME_URL=http://localhost:4000

# ── Frontend: apps/web (Next.js) ──
# Server-to-server base URL used by RSC/SSR fetches (forwards user cookies).
API_URL=http://localhost:4000
# Browser-facing base URL (inlined into the client bundle).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Socket.IO server origin for the realtime client.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
