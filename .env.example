# ─────────────────────────────────────────────────────────────
# GameLobby — single root .env consumed by every app.
# Copy to `.env` and fill in. Loaded via `bun --env-file=.env`.
# (apps/web/.env is a committed symlink → this file's sibling .env)
# ─────────────────────────────────────────────────────────────

# Postgres connection string (see scripts/docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gamelobby

# Docker host ports for scripts/docker-compose.yml. Compose reads these from
# this file (the db:* scripts pass --project-directory .). Defaults are
# 5432 / 6379 / 18081 — only set an override when a default port is already in
# use locally, and then update the matching port in DATABASE_URL / REDIS_URL.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# ADMINER_HOST_PORT=18081

# Dev/test only: artificially delay EVERY database query by N milliseconds.
# Useful for exercising loading states, timeouts and retries against local pg.
# Leave unset (or 0) in normal runs — it is a no-op then.
# DB_LATENCY_MS=800

# ── Backend: apps/server (Express + Better Auth + Socket.IO) ──
PORT=4000
# Public origin of the backend. Better Auth signs callbacks against this.
BETTER_AUTH_URL=http://localhost:4000
# Session signing key — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_with_32_byte_base64_secret
# Frontend origin (CORS + Better Auth trustedOrigins)
WEB_URL=http://localhost:3000

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis (optional). Set to enable the Socket.IO redis-adapter for multi-instance
# scale-out. Leave unset for single-node dev.
# REDIS_URL=redis://localhost:6379

# Presence tuning (optional). Redis heartbeat refresh interval, the staleness
# window after which an un-refreshed socket counts as offline, and how often
# last_seen_at is persisted to Postgres while a user is online.
# PRESENCE_HEARTBEAT_MS=10000
# PRESENCE_STALE_MS=25000
# PRESENCE_LASTSEEN_PERSIST_MS=60000

# Public realtime origin advertised by matchmaking (defaults to BETTER_AUTH_URL)
# PUBLIC_REALTIME_URL=http://localhost:4000

# Klipy GIF API key (https://partner.klipy.com). Server-only — the GIF picker is
# proxied through /api/gifs so the key never reaches the browser. NOT NEXT_PUBLIC_.
# KLIPY_API_KEY=

# Genderize.io API key (https://genderize.io). Server-only — at first sign-in it
# biases the auto-generated avatar's style from the user's name. Optional: when
# unset (or under NODE_ENV=test) the network lookup is skipped and the style
# falls back to an offline name guess, then a neutral default.
# GENDERIZE_API_KEY=

# Usernames nobody may claim, beyond the always-reserved route names. Comma-
# separated, case-insensitive. Server-only. Example: NOT_ALLOWED_USERNAMES=pulkit,kanak,admin
# NOT_ALLOWED_USERNAMES=

# Days a user must wait between username changes. Default 30. Set 0 to disable.
# USERNAME_CHANGE_COOLDOWN_DAYS=30

# ── Frontend: apps/web (Next.js) ──
# Server-to-server base URL used by RSC/SSR fetches (forwards user cookies).
API_URL=http://localhost:4000
# Browser-facing base URL (inlined into the client bundle).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Socket.IO server origin for the realtime client.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
