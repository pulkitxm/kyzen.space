{
  "name": "gamelobby",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "cloc": "cloc --vcs=git --quiet --not-match-f='(bun\\.lock|package-lock\\.json|\\.snap$|_snapshot\\.json$|_journal\\.json$)'",
    "cloc:diff": "cloc --git --diff main HEAD --quiet --not-match-f='(bun\\.lock|package-lock\\.json|\\.snap$|_snapshot\\.json$|_journal\\.json$)'",
    "cloc:md": "bun run cloc -- --md",
    "cloc:file": "bun run cloc -- --by-file",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "fix": "biome check --write . && biome check --write --unsafe --only=nursery/useSortedClasses .",
    "check": "biome check .",
    "strip-comments": "bun scripts/strip-comments.mjs",
    "db:start": "bun --env-file=.env scripts/db-compose.ts up -d postgres",
    "db:stop": "bun --env-file=.env scripts/db-compose.ts down",
    "db:reset": "bun --env-file=.env scripts/db-compose.ts down -v",
    "db:studio": "bun --env-file=.env scripts/db-compose.ts --profile studio up -d postgres adminer && echo Adminer → http://127.0.0.1:18081",
    "db:generate": "bun --env-file=.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=.env apps/server/src/db/migrate.ts",
    "db:push": "bun --env-file=.env drizzle-kit push --config=drizzle.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "drizzle-kit": "^0.30.1",
    "turbo": "^2.3.3",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.3.11"
}
