{
  "name": "kyzen",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "vid-tutorials"
  ],
  "scripts": {
    "cloc": "cloc --vcs=git --quiet --not-match-f='(bun\\.lock|package-lock\\.json|\\.snap$|_snapshot\\.json$|_journal\\.json$)'",
    "cloc:file": "bun run cloc -- --by-file",
    "cloc:authors": "bun scripts/cloc-authors.mjs",
    "clean": "bun scripts/clean.mjs",
    "ins:clean": "bun run clean && bun install",
    "dev": "bun run --cwd apps/web dev",
    "dev:clean": "bun run ins:clean && bun run dev",
    "build": "turbo run build",
    "build:clean": "bun run ins:clean && bun run build",
    "serve": "bun run build --force && bun start",
    "serve:clean": "bun run ins:clean && bun run serve",
    "start": "bun run --cwd apps/web start",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "fix": "biome check --write --unsafe --only=correctness/noUnusedImports --only=nursery/useSortedClasses . && biome check --write . && bun run fix:tw",
    "fix:tw": "cd apps/web && bun scripts/tailwind-canonical.ts --css app/globals.css \"app/**/*.{tsx,jsx,ts,js}\" \"components/**/*.{tsx,jsx,ts,js}\" \"lib/**/*.{tsx,jsx,ts,js}\" \"../../packages/games-client/src/**/*.{tsx,jsx,ts,js}\"",
    "fix:tw:check": "cd apps/web && bun scripts/tailwind-canonical.ts --css app/globals.css \"app/**/*.{tsx,jsx,ts,js}\" \"components/**/*.{tsx,jsx,ts,js}\" \"lib/**/*.{tsx,jsx,ts,js}\" \"../../packages/games-client/src/**/*.{tsx,jsx,ts,js}\" --check",
    "check": "biome ci --error-on-warnings .",
    "dead-code": "knip",
    "dead-code:fix": "knip --fix",
    "strip-comments": "bun scripts/strip-comments.mjs",
    "db:start": "docker compose -f compose.dev.yaml up -d postgres redis",
    "db:stop": "docker compose -f compose.dev.yaml stop postgres redis",
    "db:reset": "docker compose -f compose.dev.yaml down -v && bun run db:start && docker compose -f compose.dev.yaml run --rm setup",
    "db:studio": "bun --env-file=.env drizzle-kit studio --config=drizzle.config.ts",
    "db:generate": "bun --env-file=.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=.env packages/database/src/migrate.ts",
    "db:push": "bun --env-file=.env drizzle-kit push --config=drizzle.config.ts",
    "doctor": "npx react-doctor@latest",
    "dev:web": "bun --env-file=.env run --cwd apps/web dev:frontend",
    "dev:server": "bun run --cwd apps/server dev",
    "db:seed": "bun --env-file=.env packages/database/src/seed.ts",
    "lint": "biome ci --formatter-enabled=false --error-on-warnings .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false --error-on-warnings .",
    "check:comments": "bun scripts/strip-comments.mjs --check",
    "check:em-dashes": "bun scripts/check-em-dashes.mjs",
    "check:repository": "bun scripts/check-repository.mjs",
    "test:policies": "bun test scripts/tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "drizzle-kit": "^0.30.6",
    "knip": "^6.39.0",
    "turbo": "^2.11.6",
    "typescript": "^5.9.3",
    "yaml": "2.9.1",
    "postcss": "8.5.28"
  },
  "overrides": {
    "browserslist": "4.29.3",
    "engine.io": "6.6.11",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "postcss": "8.5.28",
    "shell-quote": "1.11.0",
    "socket.io-parser": "4.2.7",
    "ws": "8.22.0"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.4.2"
}
