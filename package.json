{
  "name": "gamelobby",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "fix": "biome check --write .",
    "check": "biome check .",
    "db:start": "docker compose -f scripts/docker-compose.yml up -d postgres",
    "db:stop": "docker compose -f scripts/docker-compose.yml down",
    "db:reset": "docker compose -f scripts/docker-compose.yml down -v",
    "db:studio": "docker compose -f scripts/docker-compose.yml --profile studio up -d postgres adminer && echo Adminer → http://127.0.0.1:18081",
    "db:generate": "bun --env-file=.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=.env apps/server/src/db/migrate.ts",
    "db:push": "bun --env-file=.env drizzle-kit push --config=drizzle.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "drizzle-kit": "^0.30.1",
    "turbo": "^2.3.3",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.3.11"
}
