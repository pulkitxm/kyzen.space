{
  "name": "gamelobby",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "cloc": "cloc --vcs=git --quiet --not-match-f='(bun\\.lock|package-lock\\.json|\\.snap$|_snapshot\\.json$|_journal\\.json$)'",
    "cloc:diff": "cloc --git --diff main HEAD --quiet --not-match-f='(bun\\.lock|package-lock\\.json|\\.snap$|_snapshot\\.json$|_journal\\.json$)'",
    "cloc:md": "bun run cloc -- --md",
    "cloc:file": "bun run cloc -- --by-file",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "serve": "bun run build --force && bun start",
    "start": "turbo run start",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "fix": "biome check --write --unsafe --only=correctness/noUnusedImports --only=nursery/useSortedClasses . && biome check --write . && bun run fix:tw",
    "fix:tw": "cd apps/web && tailwind-suggest-canonical-classes \"app/**/*.{tsx,jsx,ts,js}\" \"components/**/*.{tsx,jsx,ts,js}\" \"lib/**/*.{tsx,jsx,ts,js}\" \"../../packages/games-client/src/**/*.{tsx,jsx,ts,js}\" --css app/globals.css",
    "fix:tw:check": "cd apps/web && tailwind-suggest-canonical-classes \"app/**/*.{tsx,jsx,ts,js}\" \"components/**/*.{tsx,jsx,ts,js}\" \"lib/**/*.{tsx,jsx,ts,js}\" \"../../packages/games-client/src/**/*.{tsx,jsx,ts,js}\" --css app/globals.css --check",
    "check": "biome check .",
    "strip-comments": "bun scripts/strip-comments.mjs",
    "db:start": "docker compose -f scripts/docker-compose.yml up -d postgres",
    "redis:start": "docker compose -f scripts/docker-compose.yml --profile redis up -d redis",
    "db:stop": "docker compose -f scripts/docker-compose.yml down",
    "db:reset": "docker compose -f scripts/docker-compose.yml down -v && docker compose -f scripts/docker-compose.yml up -d",
    "db:studio": "docker compose -f scripts/docker-compose.yml --profile studio up -d postgres adminer && echo Adminer → http://127.0.0.1:18081",
    "db:generate": "bun --env-file=.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=.env packages/database/src/migrate.ts",
    "db:push": "bun --env-file=.env drizzle-kit push --config=drizzle.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@laststance/tailwind-suggest-canonical-classes": "^0.1.1",
    "drizzle-kit": "^0.30.1",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.3.11"
}
